# ==========================================
# SIMATS IoT Lab CoE & Expothon Environment
# ==========================================

# 1. Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/simats_iot_coe?retryWrites=true&w=majority

# 2. Authentication & JWT Security
JWT_SECRET=super-secure-random-jwt-secret-key-at-least-32-chars-long
ADMIN_INITIAL_EMAIL=admin@saveetha.simats.edu
ADMIN_INITIAL_PASSWORD=SaveethaIoTCoE2026!

# 3. Email Dispatcher (Resend API or SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="IoT Lab CoE SSE SIMATS <iotcoe.ece@saveetha.com>"
ADMIN_NOTIFICATION_EMAIL=iotcoe.ece@saveetha.com

# 4. Optional Cloud Storage (Cloudinary / Vercel Blob)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# 5. Bot Shield & Rate Limiting (Cloudflare Turnstile & Upstash Redis)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 6. Site URL (for canonical SEO and links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
